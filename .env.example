# ─────────────────────────────────────────────────────────────
# DeepSI Agent — frontend environment template
# Copy to .env.local (development) or .env.production, then restart Vite.
# Only VITE_* values are exposed to the browser. Never put secrets here.
# ─────────────────────────────────────────────────────────────

# Base URL of the Go API, including the /api/v1 prefix.
# Development default: http://localhost:8080/api/v1
# Production example: https://api.service.deepsi.space/api/v1
VITE_API_URL=http://localhost:8080/api/v1

# OpenAI-compatible LLM base URL shown in docs and code samples.
# Leave empty to derive it from the API origin + /v1.
VITE_LLM_BASE_URL=http://localhost:8080/v1

# Public identity
VITE_SITE_NAME=DeepSI Agent
VITE_SITE_DOMAIN=service.deepsi.space
VITE_SITE_EMAIL=hello@deepsi.space
VITE_SUPPORT_EMAIL=support@deepsi.space
VITE_PARENT_DOMAIN=deepsi.space
VITE_PARENT_URL=https://deepsi.space
VITE_SECURITY_EMAIL=security@deepsi.space

# Set to false to hide Google/GitHub buttons when OAuth is not configured.
VITE_OAUTH_ENABLED=true
